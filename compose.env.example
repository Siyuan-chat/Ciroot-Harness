# Non-secret, loopback-only Docker Compose defaults. Copy and edit only local ports/allowed hosts as needed.
# Build provenance values can be set by CI; unknown/empty is reported as such.
RH_BUILD_HEAD=unknown
RH_DIRTY_FILE_HASHES_JSON=

# These are host-side published ports. compose.yaml binds every published port to 127.0.0.1.
RH_PORT=8765
RH_DEMO_PORT=8766
RH_PAPERQA_PORT=8767
RH_STORM_PORT=8768
RH_ALLOWED_HOSTS=localhost,127.0.0.1

# Core research, PaperQA, and STORM profiles use separate named workspace/library volumes.
# PaperQA and STORM builds select exactly one isolated engine lock each; STORM's Linux lock selects CPU Torch.
# Demo is synthetic-only, read-only and attached to an internal network.
# No provider credentials are defined here; configure secrets outside this example.
