{
  "mode": "host",
  "data_mode": "live",
  "allow_network": true,
  "budget": {
    "max_tasks": 8,
    "max_source_calls": 12,
    "max_pages_per_query": 2,
    "max_downloads": 1,
    "max_download_calls": 12,
    "max_download_bytes": 10485760
  },
  "sources": {
    "openalex": {
      "anonymous": true,
      "year_min": 2020,
      "sort": "relevance_score:desc",
      "page_size": 5,
      "max_candidates": 10,
      "max_pages": 2,
      "timeout_seconds": 30
    }
  }
}
