{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "mode",
    "data_mode",
    "budget"
  ],
  "properties": {
    "mode": {
      "enum": [
        "host",
        "api"
      ]
    },
    "data_mode": {
      "enum": [
        "synthetic",
        "live"
      ]
    },
    "allow_network": {
      "type": "boolean"
    },
    "executor_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "data_policy": {
      "type": "object"
    },
    "sources": {
      "type": "object",
      "properties": {
        "openalex": {
          "type": "object",
          "properties": {
            "anonymous": {
              "type": "boolean"
            },
            "api_key_env": {
              "type": "string",
              "minLength": 1
            },
            "year_min": {
              "type": "integer",
              "minimum": 1900
            },
            "sort": {
              "enum": [
                "relevance_score:desc",
                "publication_date:desc",
                "cited_by_count:desc"
              ]
            },
            "page_size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "max_candidates": {
              "type": "integer",
              "minimum": 1
            },
            "max_pages": {
              "type": "integer",
              "minimum": 1
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "epo": {
          "type": "object",
          "properties": {
            "page_size": {
              "type": "integer",
              "maximum": 5,
              "minimum": 1
            },
            "max_pages": {
              "type": "integer",
              "maximum": 2,
              "minimum": 1
            },
            "max_candidates": {
              "type": "integer",
              "maximum": 20,
              "minimum": 1
            },
            "timeout_seconds": {
              "type": "integer",
              "maximum": 30,
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "patent_sources": {
      "type": "object",
      "description": "Explicit opt-in operation profiles for the core PatentSourceGateway.",
      "additionalProperties": {"type": "object"}
    },
    "budget": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "max_source_calls": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "model_api": {
      "type": "object",
      "required": [
        "provider",
        "model",
        "max_output_tokens",
        "timeout_seconds"
      ],
      "properties": {
        "provider": {
          "enum": [
            "openai",
            "anthropic",
            "deepseek",
            "qwen",
            "kimi",
            "openai_compatible"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "api_key_env": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "enum": [
            "cloud",
            "local"
          ]
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "api_key_env"
          ]
        },
        {
          "properties": {
            "profile": {
              "const": "local"
            }
          }
        }
      ]
    },
    "research_engine": {
      "type": "object",
      "required": ["name", "python_executable", "timeout_seconds"],
      "properties": {
        "name": {"enum": ["paperqa", "storm"]},
        "python_executable": {"type": "string", "minLength": 1},
        "embedding_model": {"type": "string", "minLength": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 180},
        "max_conv_turn": {"type": "integer", "minimum": 1, "maximum": 3},
        "max_search_queries_per_turn": {"type": "integer", "minimum": 1, "maximum": 3},
        "search_top_k": {"type": "integer", "minimum": 1, "maximum": 5},
        "retrieve_top_k": {"type": "integer", "minimum": 1, "maximum": 5},
        "local_embedding": {
          "type": "object",
          "required": ["python_executable", "model", "cache_dir"],
          "properties": {
            "python_executable": {"type": "string", "minLength": 1},
            "model": {"type": "string", "minLength": 1},
            "cache_dir": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {"if": {"properties": {"name": {"const": "paperqa"}}, "required": ["name"]}, "then": {"required": ["embedding_model"]}},
        {"if": {"properties": {"name": {"const": "storm"}}, "required": ["name"]}, "then": {"properties": {"embedding_model": false, "local_embedding": false}}}
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
